# Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────
# PostgreSQL Connection
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/event_recsys

# ─────────────────────────────────────────────
# Google Gemini AI (for embeddings + extraction)
# Model: text-embedding-004 (768-dim, FREE)
# Model: gemini-1.5-flash (feature extraction + explanations)
# Get key at: https://aistudio.google.com
# ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Matching Config
# ─────────────────────────────────────────────
# Number of top user matches to return per event
TOP_K_MATCHES=3
